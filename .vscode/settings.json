{
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/.pytest_cache": true,
        "**/.mypy_cache": true,
        "**/.ruff_cache": true,
        "**/.hypothesis": true,
        "**/.coverage": true,
        "**/dist": true,
        "**/build": true,
        "**/*.egg-info": true
    },
    "search.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/.pytest_cache": true,
        "**/.mypy_cache": true,
        "**/.ruff_cache": true,
        "**/.hypothesis": true,
        "**/dist": true,
        "**/build": true,
        "**/*.egg-info": true
    }
}
